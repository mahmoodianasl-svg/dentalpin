ARG PYTHON_VERSION=3.11.15
ARG PYTHON_VARIANT=slim-trixie
FROM python:${PYTHON_VERSION}-${PYTHON_VARIANT}

WORKDIR /app

# Install system dependencies (including WeasyPrint requirements for PDF generation)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    postgresql-client \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# Install the exact, hashed runtime dependency graph.
# requirements.lock is generated by scripts/compile_dependency_locks.sh.
COPY pyproject.toml requirements.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.lock

# Copy application code, then install only DentalPin itself without resolving
# dependencies again.
COPY . .
RUN python -m pip install --no-cache-dir --no-deps .

# Create non-root user and storage directory
RUN useradd -m -u 1000 appuser \
    && mkdir -p /app/storage \
    && chmod +x /app/docker-entrypoint.sh \
    && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
