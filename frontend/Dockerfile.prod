ARG NODE_VERSION=24.19.0
ARG NODE_VARIANT=alpine3.24
FROM node:${NODE_VERSION}-${NODE_VARIANT} AS builder

ARG API_BASE_URL=http://localhost:8000
ENV API_BASE_URL=$API_BASE_URL

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund

COPY backend/app/modules /module_layers

COPY frontend/ ./

# Build the production module map from the module layers copied into the image.
# This intentionally overwrites any host-only modules.json used by CI typechecking,
# so a production build cannot silently omit DentalPin's modular frontend layers.
RUN node -e 'const fs=require("node:fs"); const root="/module_layers"; const modules=fs.readdirSync(root,{withFileTypes:true}).filter((entry)=>entry.isDirectory()&&fs.existsSync(`${root}/${entry.name}/frontend`)).map((entry)=>({name:entry.name,path:`${root}/${entry.name}/frontend`})).sort((a,b)=>a.name.localeCompare(b.name)); if(modules.length===0) throw new Error("No frontend module layers found"); fs.writeFileSync("modules.json",JSON.stringify({layers:modules.map((entry)=>entry.path),modules,version:1},null,2)+"\n"); console.log(`Prepared ${modules.length} production Nuxt module layers`)'

ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build

# jsdom currently accepts undici ^7.25.0, but the reviewed frontend lock was
# generated before the 7.29.0 security release. Fetch the exact package tarball
# into an isolated patch stage without mutating the reviewed application lock.
FROM node:${NODE_VERSION}-${NODE_VARIANT} AS runtime-undici
WORKDIR /runtime-patch
RUN npm pack --ignore-scripts --silent undici@7.29.0 \
    && mkdir -p undici \
    && tar -xzf undici-7.29.0.tgz -C undici --strip-components=1 \
    && node -e 'const p=require("./undici/package.json"); if (p.version !== "7.29.0") throw new Error(`Unexpected undici ${p.version}`)' \
    && rm -f undici-7.29.0.tgz

FROM node:${NODE_VERSION}-${NODE_VARIANT}

WORKDIR /app

COPY --from=builder /app/.output /app/.output
COPY --from=runtime-undici /runtime-patch/undici /tmp/undici-7.29.0

# Patch only the vulnerable jsdom-compatible Undici line in the generated Nitro
# runtime. Fail the image build if no expected target is found or if 7.27.2
# remains afterward, so this cannot silently become a broad dependency rewrite.
RUN set -eux; \
    vulnerable_dirs="$(find /app/.output -type f -path '*/node_modules/undici/package.json' -exec sh -c 'grep -q '"'"'"version": "7.27.2"'"'"' "$1" && dirname "$1"' sh {} \;)"; \
    test -n "$vulnerable_dirs"; \
    for dir in $vulnerable_dirs; do \
      rm -rf "$dir"; \
      cp -a /tmp/undici-7.29.0 "$dir"; \
    done; \
    ! find /app/.output -type f -path '*/node_modules/undici/package.json' -exec grep -l '"version": "7.27.2"' {} + | grep -q .; \
    find /app/.output -type f -path '*/node_modules/undici/package.json' -exec grep -H '"version"' {} \;; \
    rm -rf /tmp/undici-7.29.0

# The Nitro production server needs Node, not npm/yarn/pnpm. Remove package
# managers from the final image so their transitive CLI dependencies are not
# part of the production attack surface or SBOM.
RUN rm -rf \
      /usr/local/lib/node_modules/npm \
      /usr/local/lib/node_modules/corepack \
    && rm -f \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/corepack \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg \
      /usr/local/bin/pnpm \
      /usr/local/bin/pnpx \
    && node --version

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]