ARG NODE_VERSION=24.19.0
ARG NODE_VARIANT=alpine3.24
FROM node:${NODE_VERSION}-${NODE_VARIANT} AS builder

ARG API_BASE_URL=http://localhost:8000
ENV API_BASE_URL=$API_BASE_URL

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund

COPY backend/app/modules /module_layers

COPY frontend/ ./

# Build the production module map from the module layers copied into the image.
# This intentionally overwrites any host-only modules.json used by CI typechecking,
# so a production build cannot silently omit DentalPin's modular frontend layers.
RUN node -e 'const fs=require("node:fs"); const root="/module_layers"; const modules=fs.readdirSync(root,{withFileTypes:true}).filter((entry)=>entry.isDirectory()&&fs.existsSync(`${root}/${entry.name}/frontend`)).map((entry)=>({name:entry.name,path:`${root}/${entry.name}/frontend`})).sort((a,b)=>a.name.localeCompare(b.name)); if(modules.length===0) throw new Error("No frontend module layers found"); fs.writeFileSync("modules.json",JSON.stringify({layers:modules.map((entry)=>entry.path),modules,version:1},null,2)+"\n"); console.log(`Prepared ${modules.length} production Nuxt module layers`)'

ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npm run build


FROM node:${NODE_VERSION}-${NODE_VARIANT}

WORKDIR /app

COPY --from=builder /app/.output /app/.output

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
